        bigint id_puntuacion PK
        bigint id_equipo_fantasy FK
        bigint id_jornada FK
        decimal puntos_base
        decimal puntos_mejoras
        decimal puntos_totales
    }
    NOTICIA {
        bigint id_noticia PK
        string titulo
        string resumen
        string contenido
        string imagen_url
        bigint id_autor FK
        boolean publicada
        datetime fecha_publicacion
    }
    REPORTE {
        bigint id_reporte PK
        bigint id_reportador FK
        bigint id_reportado FK
        string motivo
        string descripcion
        string estado "PENDIENTE | RESUELTO | DESCARTADO"
        datetime fecha
        bigint id_admin FK
        string resolucion
        datetime fecha_resolucion
    }
    BANEO {
        bigint id_baneo PK
        bigint id_usuario FK
        bigint id_admin FK
        datetime inicio
        datetime fin "null = permanente"
        string motivo
        string comentario
        boolean notificado
        datetime revocado_en
    }
    REGISTRO_ACTIVIDAD {
        bigint id_actividad PK
        bigint id_admin FK
        string admin_nombre
        string tipo
        string descripcion
        datetime fecha
    }
    PASSWORD_RESET_TOKEN {
        bigint id_token PK
        bigint id_usuario FK
        string token_hash "SHA-256"
        datetime expira
        boolean usado
    }

