        bigint id_transaccion PK
        bigint id_equipo_fantasy FK
        bigint id_jugador_real FK
        string tipo "COMPRA | VENTA"
        decimal precio
        datetime fecha
    }
    MEJORA {
        bigint id_mejora PK
        string nombre "ej: Triple Kill"
        string descripcion
        decimal precio
        int multiplicador_bono
        string condicion "NUEVO: TRIPLE_KILL, MVP, KDA_MINIMO..."
        decimal umbral "NUEVO"
        boolean activa "NUEVO"
    }
    MEJORA_APLICADA {
        bigint id_mejora_aplicada PK
        bigint id_equipo_fantasy FK
        bigint id_jugador_real FK
        bigint id_mejora FK
        bigint id_jornada FK
        string estado "PENDIENTE | CUMPLIDA | FALLIDA"
        decimal precio_pagado "NUEVO"
        decimal puntos_extra "NUEVO"
    }
    JORNADA {
        bigint id_jornada PK
        string nombre "ej: Semana 1 - Spring Split"
        date fecha_inicio
        date fecha_fin
        string estado "PROGRAMADA | EN_CURSO | FINALIZADA"
        string fuente_overview "NUEVO, pagina de Leaguepedia"
        datetime fecha_finalizacion "NUEVO"
    }
    PARTIDA_REAL {
        bigint id_partida PK
        bigint id_jornada FK
        string id_externo "NUEVO, unico"
        bigint id_equipo_azul FK "antes string"
        bigint id_equipo_rojo FK "antes string"
        bigint id_ganador FK "antes string"
        int duracion_segundos
        datetime fecha_hora
    }
    ESTADISTICA_JUGADOR_PARTIDA {
        bigint id_estadistica PK
        bigint id_partida FK
        bigint id_jugador_real FK
        bigint id_equipo_pro FK "NUEVO"
        string campeon "NUEVO"
        int kills
        int deaths
        int assists
        int cs
        int vision_score
        int double_kills "NUEVO"
        int triple_kills
        int quadra_kills
        int penta_kills
        boolean first_blood
        boolean victoria "NUEVO"
        boolean mvp
        decimal puntos_fantasy
    }
